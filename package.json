{
  "name": "little-piano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm test && npm run test:db && npm run build",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "seed:generate": "node scripts/seed.mjs",
    "preview": "vite preview",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.8"
  }
}
